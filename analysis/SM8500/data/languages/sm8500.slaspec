# SM8500 / SM8521 (Tiger game.com). Generated by analysis/SM8500/generate.py.
# Register-file addresses 00-0F refer to the banked registers r0-r15 selected by PS0.
define endian=big;
define alignment=1;
define space ram type=ram_space size=2 default;
define space register type=register_space size=1;

define register offset=0x00 size=1 [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
define register offset=0x00 size=2 [ rr0 rr2 rr4 rr6 rr8 rr10 rr12 rr14 ];
define register offset=0x20 size=2 [ PC SP ];
define register offset=0x28 size=1 [ CF ZF SF VF DF HF BF IF PS0 ];

define token op8(8) op=(0,7) oplo3=(0,2) oplo4=(0,3) opn3=(0,2) oppair=(0,2) opport=(0,2) opfam5=(3,7) opfam4=(4,7);
define token rtok(8) rval=(0,7) rhi=(4,7) rlo=(0,3) rwi=(1,3) rodd=(0,0);
define token rtok2(8) rval2=(0,7) rhi2=(4,7) rlo2=(0,3) rwi2=(1,3) rodd2=(0,0);
define token mtok(8) mmode=(6,7) mdst=(3,5) mdstw=(3,5) msrc=(0,2) msrcw=(0,2) msrcr=(0,2) msub=(0,2) mbit=(0,2) mhi=(3,7);
define token itok(8) imm8=(0,7) simm8=(0,7) signed;
define token itok2(8) imm8b=(0,7);
define token wtok(16) imm16=(0,15);
define token btok(8) bmode=(6,7) bbit=(0,2) bidx=(3,5);

attach variables [ rlo rlo2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ rwi rwi2 ] [ rr0 rr2 rr4 rr6 rr8 rr10 rr12 rr14 ];
attach variables [ mdst msrcr oplo3 bidx ] [ r0 r1 r2 r3 r4 r5 r6 r7 ];
attach variables [ mdstw msrcw oppair ] [ rr0 rr8 rr2 rr10 rr4 rr12 rr6 rr14 ];

macro zs8(v) { ZF = v == 0; SF = v s< 0; }
macro zs16(v) { ZF = v == 0; SF = v s< 0; }
macro push16(v) { SP = SP - 2; *:2 SP = v; }
macro pop16(v) { v = *:2 SP; SP = SP + 2; }
macro push8(v) { SP = SP - 1; *:1 SP = v; }
macro pop8(v) { v = *:1 SP; SP = SP + 1; }

# Byte register-file operand: banked register below 10h, RAM/I-O otherwise.
RB: rlo is rhi=0 & rlo { export rlo; }
RB: "R"^rval is rval { export *:1 rval; }
RB2: rlo2 is rhi2=0 & rlo2 { export rlo2; }
RB2: "R"^rval2 is rval2 { export *:1 rval2; }
RW: rwi is rhi=0 & rodd=0 & rwi { export rwi; }
RW: "RR"^rval is rval { export *:2 rval; }
RW2: rwi2 is rhi2=0 & rodd2=0 & rwi2 { export rwi2; }
RW2: "RR"^rval2 is rval2 { export *:2 rval2; }

# Byte memory through an 8-bit pointer register.
PB: "@"^msrcr is mmode=0 & msrcr { local a:2 = zext(msrcr); export *:1 a; }
PB: "("^msrcr^")+" is mmode=1 & msrcr { local a:2 = zext(msrcr); msrcr = msrcr + 1; export *:1 a; }
PB: "@"^imm8 is mmode=2 & msrc=0; imm8 { export *:1 imm8; }
PB: imm8^"("^msrcr^")" is mmode=2 & msrcr; imm8 { local a:2 = zext(msrcr) + imm8; export *:1 a; }
PB: "-("^msrcr^")" is mmode=3 & msrcr { msrcr = msrcr - 1; local a:2 = zext(msrcr); export *:1 a; }

# Byte memory through a 16-bit pointer pair.
PW: "@"^msrcw is mmode=0 & msrcw { local a:2 = msrcw; export *:1 a; }
PW: "("^msrcw^")+" is mmode=1 & msrcw { local a:2 = msrcw; msrcw = msrcw + 1; export *:1 a; }
PW: "@"^imm16 is mmode=2 & msrc=0; imm16 { export *:1 imm16; }
PW: imm16^"("^msrcw^")" is mmode=2 & msrcw; imm16 { local a:2 = msrcw + imm16; export *:1 a; }
PW: "-("^msrcw^")" is mmode=3 & msrcw { msrcw = msrcw - 1; local a:2 = msrcw; export *:1 a; }

# Word memory through a 16-bit pointer pair (auto step 2).
PW2: "@"^msrcw is mmode=0 & msrcw { local a:2 = msrcw; export *:2 a; }
PW2: "("^msrcw^")+" is mmode=1 & msrcw { local a:2 = msrcw; msrcw = msrcw + 2; export *:2 a; }
PW2: "@"^imm16 is mmode=2 & msrc=0; imm16 { export *:2 imm16; }
PW2: imm16^"("^msrcw^")" is mmode=2 & msrcw; imm16 { local a:2 = msrcw + imm16; export *:2 a; }
PW2: "-("^msrcw^")" is mmode=3 & msrcw { msrcw = msrcw - 2; local a:2 = msrcw; export *:2 a; }

# Direct-page bit operand of 1C/1D/2A/2B.
BITADDR: "$FF"^imm8 is bidx=0 & bbit; imm8 { local a:2 = 0xff00 + imm8; export *:1 a; }
BITADDR: imm8^"("^bidx^")" is bidx & bbit; imm8 { local a:2 = zext(bidx) + imm8; export *:1 a; }

REL: dest is simm8 [ dest = inst_next + simm8; ] { export *:1 dest; }
ABS: imm16 is imm16 { export *:1 imm16; }
PORT: "R"^p is opport [ p = 0x10 + opport; ] { export *:1 p; }
CALSDEST: dest is oplo4; imm8 [ dest = 0x1000 | (oplo4 << 8) | imm8; ] { export *:1 dest; }

CC: "F" is oplo4=0 { export 0:1; }
CC: "LT" is oplo4=1 { tmp:1 = SF != VF; export tmp; }
CC: "LE" is oplo4=2 { tmp:1 = ZF || (SF != VF); export tmp; }
CC: "ULE" is oplo4=3 { tmp:1 = CF || ZF; export tmp; }
CC: "OV" is oplo4=4 { export VF; }
CC: "MI" is oplo4=5 { export SF; }
CC: "Z" is oplo4=6 { export ZF; }
CC: "C" is oplo4=7 { export CF; }
CC: "T" is oplo4=8 { export 1:1; }
CC: "GE" is oplo4=9 { tmp:1 = SF == VF; export tmp; }
CC: "GT" is oplo4=10 { tmp:1 = !ZF && (SF == VF); export tmp; }
CC: "UGT" is oplo4=11 { tmp:1 = !CF && !ZF; export tmp; }
CC: "NOV" is oplo4=12 { tmp:1 = !VF; export tmp; }
CC: "PL" is oplo4=13 { tmp:1 = !SF; export tmp; }
CC: "NZ" is oplo4=14 { tmp:1 = !ZF; export tmp; }
CC: "NC" is oplo4=15 { tmp:1 = !CF; export tmp; }

define pcodeop decimal_adjust;
define pcodeop stop;
define pcodeop halt;
define pcodeop bit_move;
define pcodeop dm;

:CLR RB is op=0x00; RB { RB = 0; }
:NEG RB is op=0x01; RB { VF = RB == 0x80; RB = -RB; CF = RB == 0; zs8(RB); }
:COM RB is op=0x02; RB { RB = ~RB; zs8(RB); }
:RR RB is op=0x03; RB { CF = (RB & 1) != 0; RB = (RB >> 1) | (RB << 7); zs8(RB); }
:RL RB is op=0x04; RB { CF = (RB & 0x80) != 0; RB = (RB << 1) | (RB >> 7); zs8(RB); }
:RRC RB is op=0x05; RB { local c:1 = CF; CF = (RB & 1) != 0; RB = (RB >> 1) | (c << 7); zs8(RB); }
:RLC RB is op=0x06; RB { local c:1 = CF; CF = (RB & 0x80) != 0; RB = (RB << 1) | c; zs8(RB); }
:SRL RB is op=0x07; RB { CF = (RB & 1) != 0; RB = RB >> 1; zs8(RB); }
:INC RB is op=0x08; RB { VF = RB == 0x7f; RB = RB + 1; zs8(RB); }
:DEC RB is op=0x09; RB { VF = RB == 0x80; RB = RB - 1; zs8(RB); }
:SRA RB is op=0x0a; RB { CF = (RB & 1) != 0; RB = RB s>> 1; zs8(RB); }
:SLL RB is op=0x0b; RB { CF = (RB & 0x80) != 0; RB = RB << 1; zs8(RB); }
:DA RB is op=0x0c; RB { RB = decimal_adjust(RB, CF, HF, DF); zs8(RB); }
:SWAP RB is op=0x0d; RB { RB = (RB >> 4) | (RB << 4); }
:PUSH RB is op=0x0e; RB { push8(RB); }
:POP RB is op=0x0f; RB { pop8(RB); }
:CMP mdst,msrcr is op=0x10; mmode=0 & mdst & msrcr { local t:1 = mdst - msrcr; CF = mdst < msrcr; VF = sborrow(mdst, msrcr); zs8(t); }
:ADD mdst,msrcr is op=0x11; mmode=0 & mdst & msrcr { CF = carry(mdst, msrcr); VF = scarry(mdst, msrcr); mdst = mdst + msrcr; zs8(mdst); }
:SUB mdst,msrcr is op=0x12; mmode=0 & mdst & msrcr { CF = mdst < msrcr; VF = sborrow(mdst, msrcr); mdst = mdst - msrcr; zs8(mdst); }
:ADC mdst,msrcr is op=0x13; mmode=0 & mdst & msrcr { local c:1 = zext(CF); local t:1 = mdst + msrcr; CF = carry(mdst, msrcr) || carry(t, c); VF = scarry(mdst, msrcr) ^^ scarry(t, c); mdst = t + c; zs8(mdst); }
:SBC mdst,msrcr is op=0x14; mmode=0 & mdst & msrcr { local c:1 = zext(CF); local t:1 = mdst - msrcr; CF = (mdst < msrcr) || (t < c); VF = sborrow(mdst, msrcr) ^^ sborrow(t, c); mdst = t - c; zs8(mdst); }
:AND mdst,msrcr is op=0x15; mmode=0 & mdst & msrcr { mdst = mdst & msrcr; zs8(mdst); }
:OR mdst,msrcr is op=0x16; mmode=0 & mdst & msrcr { mdst = mdst | msrcr; zs8(mdst); }
:XOR mdst,msrcr is op=0x17; mmode=0 & mdst & msrcr { mdst = mdst ^ msrcr; zs8(mdst); }
:INCW RW is op=0x18; RW { CF = carry(RW, 1); VF = scarry(RW, 1); RW = RW + 1; zs16(RW); }
:DECW RW is op=0x19; RW { CF = RW < 1; VF = sborrow(RW, 1); RW = RW - 1; zs16(RW); }
:CLR "@"^mdst is op=0x1a; mmode=0 & mdst & msub=0 { local a:2 = zext(mdst); local v:1 = *:1 a; v = 0; *:1 a = v; }
:NEG "@"^mdst is op=0x1a; mmode=0 & mdst & msub=1 { local a:2 = zext(mdst); local v:1 = *:1 a; VF = v == 0x80; v = -v; CF = v == 0; zs8(v); *:1 a = v; }
:COM "@"^mdst is op=0x1a; mmode=0 & mdst & msub=2 { local a:2 = zext(mdst); local v:1 = *:1 a; v = ~v; zs8(v); *:1 a = v; }
:RR "@"^mdst is op=0x1a; mmode=0 & mdst & msub=3 { local a:2 = zext(mdst); local v:1 = *:1 a; CF = (v & 1) != 0; v = (v >> 1) | (v << 7); zs8(v); *:1 a = v; }
:RL "@"^mdst is op=0x1a; mmode=0 & mdst & msub=4 { local a:2 = zext(mdst); local v:1 = *:1 a; CF = (v & 0x80) != 0; v = (v << 1) | (v >> 7); zs8(v); *:1 a = v; }
:RRC "@"^mdst is op=0x1a; mmode=0 & mdst & msub=5 { local a:2 = zext(mdst); local v:1 = *:1 a; local c:1 = CF; CF = (v & 1) != 0; v = (v >> 1) | (c << 7); zs8(v); *:1 a = v; }
:RLC "@"^mdst is op=0x1a; mmode=0 & mdst & msub=6 { local a:2 = zext(mdst); local v:1 = *:1 a; local c:1 = CF; CF = (v & 0x80) != 0; v = (v << 1) | c; zs8(v); *:1 a = v; }
:SRL "@"^mdst is op=0x1a; mmode=0 & mdst & msub=7 { local a:2 = zext(mdst); local v:1 = *:1 a; CF = (v & 1) != 0; v = v >> 1; zs8(v); *:1 a = v; }
:INC "@"^mdst is op=0x1b; mmode=0 & mdst & msub=0 { local a:2 = zext(mdst); local v:1 = *:1 a; VF = v == 0x7f; v = v + 1; zs8(v); *:1 a = v; }
:DEC "@"^mdst is op=0x1b; mmode=0 & mdst & msub=1 { local a:2 = zext(mdst); local v:1 = *:1 a; VF = v == 0x80; v = v - 1; zs8(v); *:1 a = v; }
:SRA "@"^mdst is op=0x1b; mmode=0 & mdst & msub=2 { local a:2 = zext(mdst); local v:1 = *:1 a; CF = (v & 1) != 0; v = v s>> 1; zs8(v); *:1 a = v; }
:SLL "@"^mdst is op=0x1b; mmode=0 & mdst & msub=3 { local a:2 = zext(mdst); local v:1 = *:1 a; CF = (v & 0x80) != 0; v = v << 1; zs8(v); *:1 a = v; }
:DA "@"^mdst is op=0x1b; mmode=0 & mdst & msub=4 { local a:2 = zext(mdst); local v:1 = *:1 a; v = decimal_adjust(v, CF, HF, DF); zs8(v); *:1 a = v; }
:SWAP "@"^mdst is op=0x1b; mmode=0 & mdst & msub=5 { local a:2 = zext(mdst); local v:1 = *:1 a; v = (v >> 4) | (v << 4); *:1 a = v; }
:PUSH "@"^mdst is op=0x1b; mmode=0 & mdst & msub=6 { local a:2 = zext(mdst); local v:1 = *:1 a; push8(v); *:1 a = v; }
:POP "@"^mdst is op=0x1b; mmode=0 & mdst & msub=7 { local a:2 = zext(mdst); local v:1 = *:1 a; pop8(v); *:1 a = v; }
:BCLR BITADDR,"#"^bbit is op=0x1c; BITADDR & bbit ... { BITADDR = BITADDR & ~(1 << bbit); }
:BSET BITADDR,"#"^bbit is op=0x1d; BITADDR & bbit ... { BITADDR = BITADDR | (1 << bbit); }
:PUSHW RW is op=0x1e; RW { push16(RW); }
:POPW RW is op=0x1f; RW { pop16(RW); }
:CMP mdst,PB is op=0x20; (mdst ... & PB) { local t:1 = mdst - PB; CF = mdst < PB; VF = sborrow(mdst, PB); zs8(t); }
:ADD mdst,PB is op=0x21; (mdst ... & PB) { CF = carry(mdst, PB); VF = scarry(mdst, PB); mdst = mdst + PB; zs8(mdst); }
:SUB mdst,PB is op=0x22; (mdst ... & PB) { CF = mdst < PB; VF = sborrow(mdst, PB); mdst = mdst - PB; zs8(mdst); }
:ADC mdst,PB is op=0x23; (mdst ... & PB) { local c:1 = zext(CF); local t:1 = mdst + PB; CF = carry(mdst, PB) || carry(t, c); VF = scarry(mdst, PB) ^^ scarry(t, c); mdst = t + c; zs8(mdst); }
:SBC mdst,PB is op=0x24; (mdst ... & PB) { local c:1 = zext(CF); local t:1 = mdst - PB; CF = (mdst < PB) || (t < c); VF = sborrow(mdst, PB) ^^ sborrow(t, c); mdst = t - c; zs8(mdst); }
:AND mdst,PB is op=0x25; (mdst ... & PB) { mdst = mdst & PB; zs8(mdst); }
:OR mdst,PB is op=0x26; (mdst ... & PB) { mdst = mdst | PB; zs8(mdst); }
:XOR mdst,PB is op=0x27; (mdst ... & PB) { mdst = mdst ^ PB; zs8(mdst); }
:MOV mdst,PB is op=0x28; (mdst ... & PB) { mdst = PB; }
:MOV PB,mdst is op=0x29; (mdst ... & PB) { PB = mdst; }
:BBC BITADDR,"#"^bbit,REL is op=0x2a; (BITADDR & bbit ...); REL { if ((BITADDR & (1 << bbit)) == 0) goto REL; }
:BBS BITADDR,"#"^bbit,REL is op=0x2b; (BITADDR & bbit ...); REL { if ((BITADDR & (1 << bbit)) != 0) goto REL; }
:EXTS RW is op=0x2c; RW { local b:1 = RW:1; RW = sext(b); }
:DM imm8 is op=0x2d; imm8 { dm(imm8:1); }
:MOV "PS0",imm8 is op=0x2e; imm8 { PS0 = imm8; }
:BTST RB,imm8 is op=0x2f; RB; imm8 { VF = 0; ZF = (RB & imm8) == 0; }
:CMP mdst,PW is op=0x30; (mdst ... & PW) { local t:1 = mdst - PW; CF = mdst < PW; VF = sborrow(mdst, PW); zs8(t); }
:ADD mdst,PW is op=0x31; (mdst ... & PW) { CF = carry(mdst, PW); VF = scarry(mdst, PW); mdst = mdst + PW; zs8(mdst); }
:SUB mdst,PW is op=0x32; (mdst ... & PW) { CF = mdst < PW; VF = sborrow(mdst, PW); mdst = mdst - PW; zs8(mdst); }
:ADC mdst,PW is op=0x33; (mdst ... & PW) { local c:1 = zext(CF); local t:1 = mdst + PW; CF = carry(mdst, PW) || carry(t, c); VF = scarry(mdst, PW) ^^ scarry(t, c); mdst = t + c; zs8(mdst); }
:SBC mdst,PW is op=0x34; (mdst ... & PW) { local c:1 = zext(CF); local t:1 = mdst - PW; CF = (mdst < PW) || (t < c); VF = sborrow(mdst, PW) ^^ sborrow(t, c); mdst = t - c; zs8(mdst); }
:AND mdst,PW is op=0x35; (mdst ... & PW) { mdst = mdst & PW; zs8(mdst); }
:OR mdst,PW is op=0x36; (mdst ... & PW) { mdst = mdst | PW; zs8(mdst); }
:XOR mdst,PW is op=0x37; (mdst ... & PW) { mdst = mdst ^ PW; zs8(mdst); }
:MOV mdst,PW is op=0x38; (mdst ... & PW) { mdst = PW; }
:MOV PW,mdst is op=0x39; (mdst ... & PW) { PW = mdst; }
:MOVW mdstw,PW2 is op=0x3a; (mdstw ... & PW2) { mdstw = PW2; }
:MOVW PW2,mdstw is op=0x3b; (mdstw ... & PW2) { PW2 = mdstw; }
:MOVW mdstw,msrcw is op=0x3c; mmode=0 & mdstw & msrcw { mdstw = msrcw; }
:DM RB is op=0x3d; RB { dm(RB); }
:JMP "@"^msrcw is op=0x3e; mmode=0 & msrcw { goto [msrcw]; }
:JMP "@"^imm16 is op=0x3e; mmode=1 & mdst=0; imm16 { local a:2 = imm16; local t:2 = *:2 a; goto [t]; }
:JMP "@"^imm16^"("^mdst^")" is op=0x3e; mmode=1 & mdst; imm16 { local a:2 = zext(mdst); a = a + imm16; local t:2 = *:2 a; goto [t]; }
:CALL "@"^msrcw is op=0x3f; mmode=0 & msrcw { local ret:2 = inst_next; push16(ret); call [msrcw]; }
:CALL "@"^imm16 is op=0x3f; mmode=1 & mdst=0; imm16 { local a:2 = imm16; local t:2 = *:2 a; local ret:2 = inst_next; push16(ret); call [t]; }
:CALL "@"^imm16^"("^mdst^")" is op=0x3f; mmode=1 & mdst; imm16 { local a:2 = zext(mdst); a = a + imm16; local t:2 = *:2 a; local ret:2 = inst_next; push16(ret); call [t]; }
:CMP RB2,RB is op=0x40; RB; RB2 { local t:1 = RB2 - RB; CF = RB2 < RB; VF = sborrow(RB2, RB); zs8(t); }
:ADD RB2,RB is op=0x41; RB; RB2 { CF = carry(RB2, RB); VF = scarry(RB2, RB); RB2 = RB2 + RB; zs8(RB2); }
:SUB RB2,RB is op=0x42; RB; RB2 { CF = RB2 < RB; VF = sborrow(RB2, RB); RB2 = RB2 - RB; zs8(RB2); }
:ADC RB2,RB is op=0x43; RB; RB2 { local c:1 = zext(CF); local t:1 = RB2 + RB; CF = carry(RB2, RB) || carry(t, c); VF = scarry(RB2, RB) ^^ scarry(t, c); RB2 = t + c; zs8(RB2); }
:SBC RB2,RB is op=0x44; RB; RB2 { local c:1 = zext(CF); local t:1 = RB2 - RB; CF = (RB2 < RB) || (t < c); VF = sborrow(RB2, RB) ^^ sborrow(t, c); RB2 = t - c; zs8(RB2); }
:AND RB2,RB is op=0x45; RB; RB2 { RB2 = RB2 & RB; zs8(RB2); }
:OR RB2,RB is op=0x46; RB; RB2 { RB2 = RB2 | RB; zs8(RB2); }
:XOR RB2,RB is op=0x47; RB; RB2 { RB2 = RB2 ^ RB; zs8(RB2); }
:MOV RB2,RB is op=0x48; RB; RB2 { RB2 = RB; }
:CALL ABS is op=0x49; ABS { local ret:2 = inst_next; push16(ret); call ABS; }
:MOVW RW2,RW is op=0x4a; RW; RW2 { RW2 = RW; }
:MOVW RW,"#"^imm16 is op=0x4b; RW; imm16 { RW = imm16; }
:MULT RW2,RB is op=0x4c; RB; RW2 { local lo:1 = RW2:1; RW2 = zext(lo) * zext(RB); ZF = RW2 == 0; VF = 0; }
:MULT RW2,"#"^imm8 is op=0x4d; imm8; RW2 { local lo:1 = RW2:1; RW2 = zext(lo) * imm8; ZF = RW2 == 0; VF = 0; }
:BMOV RB,"#"^bbit,"BF" is op=0x4e; bmode=1 & bbit; RB { RB = (RB & ~(1 << bbit)) | (BF << bbit); }
:BMOV "BF",RB,"#"^bbit is op=0x4e; bmode=0 & bbit; RB { BF = (RB >> bbit) & 1; ZF = BF == 0; }
:BCMP "BF",RB,"#"^bbit is op=0x4f; bmode=0 & bbit; RB { local b:1 = (RB >> bbit) & 1; ZF = b == BF; }
:BAND "BF",RB,"#"^bbit is op=0x4f; bmode=1 & bbit; RB { local b:1 = (RB >> bbit) & 1; BF = b & BF; ZF = BF == 0; }
:BOR "BF",RB,"#"^bbit is op=0x4f; bmode=2 & bbit; RB { local b:1 = (RB >> bbit) & 1; BF = b | BF; ZF = BF == 0; }
:BXOR "BF",RB,"#"^bbit is op=0x4f; bmode=3 & bbit; RB { local b:1 = (RB >> bbit) & 1; BF = b ^ BF; ZF = BF == 0; }
:CMP RB2,"#"^imm8 is op=0x50; imm8; RB2 { local t:1 = RB2 - imm8; CF = RB2 < imm8; VF = sborrow(RB2, imm8); zs8(t); }
:ADD RB2,"#"^imm8 is op=0x51; imm8; RB2 { CF = carry(RB2, imm8); VF = scarry(RB2, imm8); RB2 = RB2 + imm8; zs8(RB2); }
:SUB RB2,"#"^imm8 is op=0x52; imm8; RB2 { CF = RB2 < imm8; VF = sborrow(RB2, imm8); RB2 = RB2 - imm8; zs8(RB2); }
:ADC RB2,"#"^imm8 is op=0x53; imm8; RB2 { local c:1 = zext(CF); local t:1 = RB2 + imm8; CF = carry(RB2, imm8) || carry(t, c); VF = scarry(RB2, imm8) ^^ scarry(t, c); RB2 = t + c; zs8(RB2); }
:SBC RB2,"#"^imm8 is op=0x54; imm8; RB2 { local c:1 = zext(CF); local t:1 = RB2 - imm8; CF = (RB2 < imm8) || (t < c); VF = sborrow(RB2, imm8) ^^ sborrow(t, c); RB2 = t - c; zs8(RB2); }
:AND RB2,"#"^imm8 is op=0x55; imm8; RB2 { RB2 = RB2 & imm8; zs8(RB2); }
:OR RB2,"#"^imm8 is op=0x56; imm8; RB2 { RB2 = RB2 | imm8; zs8(RB2); }
:XOR RB2,"#"^imm8 is op=0x57; imm8; RB2 { RB2 = RB2 ^ imm8; zs8(RB2); }
:MOV RB2,"#"^imm8 is op=0x58; imm8; RB2 { RB2 = imm8; }
:CMP "@"^msrcw,"#"^imm8 is op=0x5a; mmode=0 & msrcw; imm8 { local a:2 = msrcw; local m:1 = *:1 a; local t:1 = m - imm8; CF = m < imm8; VF = sborrow(m, imm8); zs8(t); }
:CMP "("^msrcw^")+","#"^imm8 is op=0x5a; mmode=1 & msrcw; imm8 { local a:2 = msrcw; msrcw = msrcw + 1; local m:1 = *:1 a; local t:1 = m - imm8; CF = m < imm8; VF = sborrow(m, imm8); zs8(t); }
:CMP imm8b^"("^msrcw^")","#"^imm8 is op=0x5a; mmode=2 & msrcw; imm8b; imm8 { local a:2 = msrcw + imm8b; local m:1 = *:1 a; local t:1 = m - imm8; CF = m < imm8; VF = sborrow(m, imm8); zs8(t); }
:CMP "-("^msrcw^")","#"^imm8 is op=0x5a; mmode=3 & msrcw; imm8 { msrcw = msrcw - 1; local a:2 = msrcw; local m:1 = *:1 a; local t:1 = m - imm8; CF = m < imm8; VF = sborrow(m, imm8); zs8(t); }
:MOV "@"^msrcw,"#"^imm8 is op=0x5b; mmode=0 & msrcw; imm8 { local a:2 = msrcw; *:1 a = imm8; }
:MOV "("^msrcw^")+","#"^imm8 is op=0x5b; mmode=1 & msrcw; imm8 { local a:2 = msrcw; msrcw = msrcw + 1; *:1 a = imm8; }
:MOV imm8b^"("^msrcw^")","#"^imm8 is op=0x5b; mmode=2 & msrcw; imm8b; imm8 { local a:2 = msrcw + imm8b; *:1 a = imm8; }
:MOV "-("^msrcw^")","#"^imm8 is op=0x5b; mmode=3 & msrcw; imm8 { msrcw = msrcw - 1; local a:2 = msrcw; *:1 a = imm8; }
:DIV RW2,RW is op=0x5c; RW; RW2 { local dv:1 = RW:1; local d:2 = zext(dv); VF = d == 0; local q:2 = RW2 / d; local r:2 = RW2 % d; RW = (RW & 0x00ff) | (r << 8); RW2 = q; ZF = q == 0; }
:DIV RW2,"#"^imm8 is op=0x5d; imm8; RW2 { local d:2 = imm8; VF = d == 0; RW2 = RW2 / d; ZF = RW2 == 0; }
:MOVM RB,"#"^imm8b,RB2 is op=0x5e; RB; imm8b; RB2 { RB = (RB & imm8b) | RB2; }
:MOVM RB,"#"^imm8b,"#"^imm8 is op=0x5f; RB; imm8b; imm8 { RB = (RB & imm8b) | imm8; }
:CMPW RW2,RW is op=0x60; RW; RW2 { local t:2 = RW2 - RW; CF = RW2 < RW; VF = sborrow(RW2, RW); zs16(t); }
:ADDW RW2,RW is op=0x61; RW; RW2 { CF = carry(RW2, RW); VF = scarry(RW2, RW); RW2 = RW2 + RW; zs16(RW2); }
:SUBW RW2,RW is op=0x62; RW; RW2 { CF = RW2 < RW; VF = sborrow(RW2, RW); RW2 = RW2 - RW; zs16(RW2); }
:ADCW RW2,RW is op=0x63; RW; RW2 { local c:2 = zext(CF); local t:2 = RW2 + RW; CF = carry(RW2, RW) || carry(t, c); VF = scarry(RW2, RW) ^^ scarry(t, c); RW2 = t + c; zs16(RW2); }
:SBCW RW2,RW is op=0x64; RW; RW2 { local c:2 = zext(CF); local t:2 = RW2 - RW; CF = (RW2 < RW) || (t < c); VF = sborrow(RW2, RW) ^^ sborrow(t, c); RW2 = t - c; zs16(RW2); }
:ANDW RW2,RW is op=0x65; RW; RW2 { RW2 = RW2 & RW; zs16(RW2); }
:ORW RW2,RW is op=0x66; RW; RW2 { RW2 = RW2 | RW; zs16(RW2); }
:XORW RW2,RW is op=0x67; RW; RW2 { RW2 = RW2 ^ RW; zs16(RW2); }
:CMPW RW,"#"^imm16 is op=0x68; RW; imm16 { local t:2 = RW - imm16; CF = RW < imm16; VF = sborrow(RW, imm16); zs16(t); }
:ADDW RW,"#"^imm16 is op=0x69; RW; imm16 { CF = carry(RW, imm16); VF = scarry(RW, imm16); RW = RW + imm16; zs16(RW); }
:SUBW RW,"#"^imm16 is op=0x6a; RW; imm16 { CF = RW < imm16; VF = sborrow(RW, imm16); RW = RW - imm16; zs16(RW); }
:ADCW RW,"#"^imm16 is op=0x6b; RW; imm16 { local c:2 = zext(CF); local t:2 = RW + imm16; CF = carry(RW, imm16) || carry(t, c); VF = scarry(RW, imm16) ^^ scarry(t, c); RW = t + c; zs16(RW); }
:SBCW RW,"#"^imm16 is op=0x6c; RW; imm16 { local c:2 = zext(CF); local t:2 = RW - imm16; CF = (RW < imm16) || (t < c); VF = sborrow(RW, imm16) ^^ sborrow(t, c); RW = t - c; zs16(RW); }
:ANDW RW,"#"^imm16 is op=0x6d; RW; imm16 { RW = RW & imm16; zs16(RW); }
:ORW RW,"#"^imm16 is op=0x6e; RW; imm16 { RW = RW | imm16; zs16(RW); }
:XORW RW,"#"^imm16 is op=0x6f; RW; imm16 { RW = RW ^ imm16; zs16(RW); }
:DBNZ oplo3,REL is opfam5=0x0e & oplo3; REL { oplo3 = oplo3 - 1; if (oplo3 != 0) goto REL; }
:MOVW oppair,"#"^imm16 is opfam5=0x0f & oppair; imm16 { oppair = imm16; }
:BBC RB,"#"^opn3,REL is opfam5=0x10 & opn3; RB; REL { if ((RB & (1 << opn3)) == 0) goto REL; }
:BBS RB,"#"^opn3,REL is opfam5=0x11 & opn3; RB; REL { if ((RB & (1 << opn3)) != 0) goto REL; }
:JMP CC,ABS is opfam4=0x9 & CC; ABS { if (CC) goto ABS; }
:JMP ABS is op=0x98; ABS { goto ABS; }
:BCLR RB,"#"^opn3 is opfam5=0x14 & opn3; RB { RB = RB & ~(1 << opn3); }
:BSET RB,"#"^opn3 is opfam5=0x15 & opn3; RB { RB = RB | (1 << opn3); }
:MOV oplo3,RB is opfam5=0x16 & oplo3; RB { oplo3 = RB; }
:MOV RB,oplo3 is opfam5=0x17 & oplo3; RB { RB = oplo3; }
:MOV oplo3,"#"^imm8 is opfam5=0x18 & oplo3; imm8 { oplo3 = imm8; }
:MOV PORT,"#"^imm8 is opfam5=0x19 & PORT; imm8 { PORT = imm8; }
:BR CC,REL is opfam4=0xd & CC; REL { if (CC) goto REL; }
:BR REL is op=0xd8; REL { goto REL; }
:CALS CALSDEST is (opfam4=0xe ... & CALSDEST) { local ret:2 = inst_next; push16(ret); call CALSDEST; }
:STOP is op=0xf0 { stop(); }
:HALT is op=0xf1 { halt(); }
:RET is op=0xf8 { local t:2 = *:2 SP; SP = SP + 2; return [t]; }
:IRET is op=0xf9 { SP = SP + 1; local t:2 = *:2 SP; SP = SP + 2; return [t]; }
:CLRC is op=0xfa { CF = 0; }
:COMC is op=0xfb { CF = !CF; }
:SETC is op=0xfc { CF = 1; }
:EI is op=0xfd { IF = 1; }
:DI is op=0xfe { IF = 0; }
:NOP is op=0xff { }
