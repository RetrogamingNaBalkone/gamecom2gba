<compiler_spec>
  <global><range space="ram"/></global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress><varnode space="stack" offset="0" size="2"/></returnaddress>
  <default_proto><prototype name="__cart" extrapop="2" stackshift="2">
    <input/><output/><unaffected><register name="SP"/></unaffected>
  </prototype></default_proto>
</compiler_spec>
